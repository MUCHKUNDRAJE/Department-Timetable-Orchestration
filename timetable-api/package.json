{
  "name": "timetable-api",
  "version": "1.0.0",
  "description": "Department Timetable Orchestration System — REST API Backend",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "migrate": "node -e \"const {Pool}=require('pg');const fs=require('fs');const pool=new Pool({connectionString:process.env.DATABASE_URL});pool.query(fs.readFileSync('./migrations/001_init.sql','utf8')).then(()=>{console.log('Migration done');pool.end()}).catch(e=>{console.error(e);pool.end(1)})\"",
    "seed": "node src/seed/seedData.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "pg": "^8.12.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
